# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# Database
# Leave DB_NAME unset (or DATABASE_ENGINE=sqlite3) to use a local SQLite file
# with zero setup, which is fine for quick evaluation and running the test
# suite. Set these for the intended production database, PostgreSQL:
DATABASE_ENGINE=sqlite3
DB_NAME=placify
DB_USER=placify_user
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

# Email (used for the "forgot password" flow). Defaults to printing emails to
# the console if unset — nothing to configure for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@placify.local

# Seed data (python manage.py seed_data) — override the default seeded
# passwords for the admin/recruiter accounts before running in any shared
# environment.
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_RECRUITER_PASSWORD=RecruiterPass123!

# Production hardening (only read when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Optional AI assistance
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
